  <vhdl appearance="logisim_evolution" name="rs_latch">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY rs_latch IS
  PORT (
    s  : IN  std_logic;
    r  : IN  std_logic;
    q  : OUT std_logic;
    nq : OUT std_logic
  );
END rs_latch;

ARCHITECTURE bhv OF rs_latch IS
  SIGNAL q_int  : std_logic := '0';
  SIGNAL nq_int : std_logic := '1';
BEGIN
  q_int  &lt;= r NOR nq_int;
  nq_int &lt;= s NOR q_int;
  q  &lt;= q_int;
  nq &lt;= nq_int;
END bhv;</vhdl>
