  <vhdl appearance="logisim_evolution" name="d_latch">LIBRARY ieee;
USE ieee.std_logic_1164.ALL;

ENTITY d_latch IS
  PORT (
    en : IN  std_logic;
    d  : IN  std_logic;
    q  : OUT std_logic;
    nq : OUT std_logic
  );
END d_latch;

ARCHITECTURE bhv OF d_latch IS
  SIGNAL q_int : std_logic := '0';
BEGIN
  PROCESS(en, d)
  BEGIN
    IF (en = '1') THEN
      q_int &lt;= d;
    END IF;
  END PROCESS;

  q  &lt;= q_int;
  nq &lt;= NOT q_int;
END bhv;</vhdl>
